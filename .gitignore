# Local SDD / superpowers framework (not part of the marketplace)
.superpowers/

# Node dependencies & build output
node_modules/
dist/
build/

# Environment & secrets — never commit
.env
.env.*
!.env.example

# Test / run output
reports/
test-results/
playwright/.auth/

# OS & editor junk
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Stray drops at the repo root (e.g. downloaded lead/XML files)
/index.html
/*.xml

# Local-only notes and profiles that hold org specifics — never commit to the public repo
plugins/*/docs/enhancement/plugin-gaps-*.md
.claude/workspace-profile.json
**/.claude/workspace-profile.json
.claude/design-intelligence/
**/.claude/design-intelligence/

# Private leak denylist (real employer/product/client/people terms) — local only
.leak-denylist.local
