{
  "screen": "SCR-01",
  "css": [
    ".sp-scr-01, .sp-scr-01 * { box-sizing: border-box; }",
    ".sp-scr-01 { margin: 0; font-family: var(--brand-font, system-ui, sans-serif); color: var(--brand-text, #222); background: var(--brand-background, #f5f5f5); }",
    ".sp-scr-01 h1, .sp-scr-01 h2 { font-weight: var(--brand-title-weight, 600); }",
    ".sp-scr-01 .shell { display: grid; grid-template-columns: 144px 1fr; min-height: 900px; }",
    ".sp-scr-01 .rail { display: flex; flex-direction: column; gap: 4px; padding: 16px 8px; background: #fff; border-right: 1px solid #e3e7ee; }",
    ".sp-scr-01 .rail-logo { display: block; margin: 0 0 16px; max-width: 100%; align-self: flex-start; }",
    ".sp-scr-01 .rail-link { padding: 8px; border-radius: 8px; color: inherit; text-decoration: none; font-size: 12px; }",
    ".sp-scr-01 .rail-link.active { background: var(--brand-primary); color: #fff; }",
    ".sp-scr-01 .main { padding: 24px 32px; }",
    ".sp-scr-01 .topbar { display: flex; align-items: center; justify-content: space-between; }",
    ".sp-scr-01 .bell, .sp-scr-01 .tabs [role=tab], .sp-scr-01 .drawer button, .sp-scr-01 dialog button { font: inherit; border-radius: 8px; border: 1px solid #cfd6e0; background: #fff; padding: 6px 12px; cursor: pointer; }",
    ".sp-scr-01 .badge { display: inline-block; min-width: 18px; padding: 0 5px; border-radius: 9px; background: var(--brand-error); color: #fff; font-size: 12px; }",
    ".sp-scr-01 .tabs { display: flex; gap: 8px; margin: 16px 0; }",
    ".sp-scr-01 .tabs [aria-selected=true] { background: var(--brand-primary); color: #fff; border-color: var(--brand-primary); }",
    ".sp-scr-01 .grid { width: 100%; border-collapse: collapse; background: #fff; border-radius: 12px; overflow: hidden; }",
    ".sp-scr-01 .grid th, .sp-scr-01 .grid td { text-align: left; padding: 10px 12px; border-bottom: 1px solid #eef1f5; }",
    ".sp-scr-01 .grid tbody tr { cursor: pointer; }",
    ".sp-scr-01 .drawer { position: fixed; top: 0; right: 0; bottom: 0; width: 380px; background: #fff; box-shadow: -8px 0 24px rgba(0, 0, 0, .12); padding: 20px; display: flex; flex-direction: column; gap: 12px; }",
    ".sp-scr-01 .drawer footer { margin-top: auto; display: flex; gap: 8px; justify-content: flex-end; }",
    ".sp-scr-01 .primary { background: var(--brand-primary) !important; color: #fff; border-color: var(--brand-primary) !important; }",
    ".sp-scr-01 .danger-outline { color: var(--brand-error); border-color: var(--brand-error) !important; }",
    ".sp-scr-01 .panel { position: fixed; top: 64px; right: 24px; width: 300px; background: #fff; border-radius: 12px; box-shadow: 0 8px 24px rgba(0, 0, 0, .14); padding: 12px 16px; }",
    ".sp-scr-01 .note { list-style: none; padding: 8px 0; border-bottom: 1px solid #eef1f5; }",
    ".sp-scr-01 .note time { display: block; font-size: 12px; opacity: .7; }",
    ".sp-scr-01 dialog { border: none; border-radius: 12px; padding: 20px; width: 420px; }",
    ".sp-scr-01 dialog textarea { width: 100%; font: inherit; }",
    ".sp-scr-01 dialog menu { display: flex; gap: 8px; justify-content: flex-end; padding: 0; }",
    ".sp-scr-01 .toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); background: var(--brand-text); color: #fff; padding: 10px 16px; border-radius: 8px; }",
    ".sp-scr-01 [hidden] { display: none !important; }"
  ],
