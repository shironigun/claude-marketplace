{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "house-style.json: film rules learned from review rounds, in a repository's profile or for the user (spec 10)",
  "type": "object",
  "required": ["rules"],
  "additionalProperties": false,
  "properties": {
    "rules": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["id", "text", "scope"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[HU]-\\d{2,}$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\r\\n<]*$" },
          "scope": { "enum": ["generic", "product"] },
          "mods": {
            "type": "object",
            "additionalProperties": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 40 }
          }
        }
      }
    }
  }
}
