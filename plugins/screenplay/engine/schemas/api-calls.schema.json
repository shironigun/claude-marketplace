{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "api-calls.json: every API call the feature makes (spec 5.4)",
  "type": "object",
  "required": ["calls"],
  "additionalProperties": false,
  "properties": {
    "branch": { "type": "string", "minLength": 1 },
    "calls": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/call" } }
  },
  "$defs": {
    "call": {
      "type": "object",
      "required": ["id", "style", "method", "path", "caller"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^API-\\d{2,}$" },
        "style": { "enum": ["rest", "graphql"] },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/" },
        "operation": { "type": "string", "minLength": 1 },
        "requestType": { "type": "string", "minLength": 1 },
        "responseType": { "type": "string", "minLength": 1 },
        "auth": { "enum": ["sign-in", "feature", "other"] },
        "caller": {
          "type": "object",
          "required": ["path", "line"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "line": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
