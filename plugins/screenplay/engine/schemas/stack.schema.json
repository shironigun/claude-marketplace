{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stack.json: what the detectors found (spec 6)",
  "type": "object",
  "required": ["repository", "detectedAt", "frontend", "backend", "layout"],
  "additionalProperties": false,
  "properties": {
    "repository": { "type": "string", "minLength": 1 },
    "detectedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "frontend": {
      "type": "object",
      "required": ["frameworks", "routing", "apiStyles", "contracts", "auth", "theming", "devServers", "i18n", "fonts"],
      "additionalProperties": false,
      "properties": {
        "frameworks": { "$ref": "#/$defs/findings" },
        "routing": { "$ref": "#/$defs/findings" },
        "apiStyles": { "$ref": "#/$defs/findings" },
        "contracts": { "$ref": "#/$defs/findings" },
        "auth": { "$ref": "#/$defs/findings" },
        "theming": { "$ref": "#/$defs/findings" },
        "devServers": { "$ref": "#/$defs/findings" },
        "i18n": { "$ref": "#/$defs/findings" },
        "fonts": { "$ref": "#/$defs/findings" }
      }
    },
    "backend": {
      "type": "object",
      "required": ["languages", "frameworks"],
      "additionalProperties": false,
      "properties": {
        "languages": { "$ref": "#/$defs/findings" },
        "frameworks": { "$ref": "#/$defs/findings" }
      }
    },
    "layout": {
      "type": "object",
      "required": ["kind", "packages"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["single", "monorepo"] },
        "packages": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "finding": {
      "type": "object",
      "required": ["id", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]*$" },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
