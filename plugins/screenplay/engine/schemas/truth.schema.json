{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "truth.json: the truth ledger; every entry cites path:line@commit (spec 5.5)",
  "type": "object",
  "required": ["entries"],
  "additionalProperties": false,
  "properties": {
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "kind", "statement", "evidence", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^T-\\d{2,}$" },
        "kind": { "enum": ["does", "manual-only", "limit", "does-not", "never-populated", "hidden"] },
        "statement": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "line", "quote"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "line": { "type": "integer", "minimum": 1 },
              "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
              "quote": { "type": "string", "minLength": 1 }
            }
          }
        },
        "confidence": { "enum": ["confirmed", "inferred", "open"] },
        "boundary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
