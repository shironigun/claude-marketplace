{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "demo-data.json: the demo answers the subject's calls give in the film's screens, by call id; an answer can be for some path parameters or query values, and from a scene of the story on (spec 5.9, 5.11)",
  "type": "object",
  "required": ["calls"],
  "additionalProperties": false,
  "properties": {
    "calls": { "type": "object", "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/response" } } }
  },
  "$defs": {
    "values": { "type": "object", "additionalProperties": { "type": "string" } },
    "response": {
      "type": "object",
      "required": ["body"],
      "additionalProperties": false,
      "properties": {
        "when": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "params": { "$ref": "#/$defs/values" }, "query": { "$ref": "#/$defs/values" } }
        },
        "from": { "type": "string", "pattern": "^S-\\d{2,}$" },
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "body": {}
      }
    }
  }
}
