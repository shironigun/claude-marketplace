{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "screens/<screen id>.json: one screen of a film, rebuilt from the code: its CSS, the markup of each scene on it (the page, and each drawer, dialog and toast the scene opens), the values the code left open, and the evidence (spec 5.11)",
  "type": "object",
  "required": ["screen", "css", "scenes", "guesses", "evidence"],
  "additionalProperties": false,
  "properties": {
    "screen": { "type": "string", "pattern": "^SCR-\\d{2,}$" },
    "css": { "$ref": "#/$defs/text" },
    "scenes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scene" } },
    "guesses": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\r\\n]*$" } },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/citation" } }
  },
  "$defs": {
    "text": { "type": ["string", "array"], "items": { "type": "string" } },
    "scene": {
      "type": "object",
      "required": ["scene", "surfaces"],
      "additionalProperties": false,
      "properties": {
        "scene": { "type": "string", "pattern": "^S-\\d{2,}$" },
        "surfaces": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/surface" } }
      }
    },
    "surface": {
      "type": "object",
      "required": ["kind", "html"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["page", "drawer", "dialog", "toast"] },
        "action": { "type": "string", "minLength": 1 },
        "html": { "$ref": "#/$defs/text" }
      }
    },
    "citation": {
      "type": "object",
      "required": ["path", "line", "quote"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "quote": { "type": "string", "minLength": 1 }
      }
    }
  }
}
