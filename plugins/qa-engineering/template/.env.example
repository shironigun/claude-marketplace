# ─────────────────────────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill it in.  NEVER commit `.env` (see .gitignore).
#
#  Every key below can also be set with a profile prefix — `<PREFIX>_<KEY>` —
#  so one file can hold several environments/tenants:
#
#      API_BASE_URL=https://qa.example.com/api          ← global default
#      STAGING_API_BASE_URL=https://staging.example.com/api
#
#  The active profile decides which prefix wins. Prefixed value first,
#  un-prefixed global as the fallback. See config/profiles.index.ts.
# ─────────────────────────────────────────────────────────────────────────────


# === Execution ===============================================================

# Which profile in config/profiles.index.ts to run as.
AUTOMATION_PROFILE=default

# Soft response-time budget. Slow responses are annotated, never failed.
RESPONSE_TIME_THRESHOLD_MS=2000


# === Services ================================================================
# One entry per API host your backend exposes. Every key listed here must have a
# matching entry in config/services.ts — that file is the registry, this file is
# the value. Add a service in config/services.ts first, then add its URL here.

API_BASE_URL=

# Example of a second host, after registering `orders` in config/services.ts:
# ORDERS_API_BASE_URL=


# === Default headers =========================================================
# Sent on EVERY request, before auth and before any per-call override. This is
# where a gateway subscription key, a static API key alongside the bearer, or a
# required API-version header belongs — anything the real client sends every time.
#
# JSON object. Leave blank for most backends.
#   DEFAULT_HEADERS={"Ocp-Apim-Subscription-Key":"…"}
#   DEFAULT_HEADERS={"x-api-key":"…","Api-Version":"2024-01-01"}
#
# Needs a SIGNED request instead (HMAC, a per-request nonce)? Compute it in
# ApiClient.buildOptions() — one method, every request passes through it.
DEFAULT_HEADERS=


# === Authentication ==========================================================
# Strategy: password | client-credentials | static | none
#
#   password           — POST credentials to a login endpoint, read a token out of the response
#   client-credentials — OAuth2 form POST (client_id/client_secret/scope) to a token endpoint
#   static             — use AUTH_STATIC_TOKEN verbatim (short-lived; good for a spike)
#   none               — send no Authorization header at all
AUTH_STRATEGY=password

# Host that mints the token. Often the same as API_BASE_URL, often not.
AUTH_BASE_URL=

# Path appended to AUTH_BASE_URL. Leading slash is optional.
AUTH_LOGIN_PATH=auth/login

# Where the token lives in the login response. Dot-path — `data.token` works.
# Common values: access_token · token · authToken · data.accessToken
AUTH_TOKEN_FIELD=access_token

# Field NAMES the login endpoint expects in its JSON body.
AUTH_USERNAME_FIELD=username
AUTH_PASSWORD_FIELD=password

# Optional extra body field carrying the tenant/account id (e.g. orgId, accountId).
# Leave empty if your login body has no tenant field.
AUTH_TENANT_FIELD=

# Any additional constant fields the login body needs, as JSON.
# e.g. AUTH_EXTRA_BODY={"grantType":"password","rememberMe":false}
AUTH_EXTRA_BODY=

# --- Identity from the login response ----------------------------------------
# Some APIs scope every route to an account/tenant id the LOGIN RESPONSE returns,
# which can differ from what the user typed. Set a dot-path and the active profile's
# `testTenantId` is read from the login body (like a real client). Leave empty to use
# the env-configured AUTH_TENANT_ID below.
#   AUTH_IDENTITY_TENANT_FIELD=accountId          (or data.account.id, etc.)
AUTH_IDENTITY_TENANT_FIELD=
# Dot-path to the user id in the login body, when it is not in the token's claims.
AUTH_IDENTITY_USER_FIELD=

# How the token is attached to every request.
AUTH_HEADER_NAME=Authorization
AUTH_SCHEME=Bearer

# --- strategy: static --------------------------------------------------------
AUTH_STATIC_TOKEN=

# --- strategy: client-credentials -------------------------------------------
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_SCOPE=
AUTH_AUDIENCE=
AUTH_GRANT_TYPE=client_credentials


# === Credentials =============================================================
# The account every test authenticates as by default.
# AUTH_TENANT_ID doubles as `profile.testTenantId` — the tenant/account id your
# routes are scoped to (orgId, companyId, accountId, …). Leave empty if unused,
# or if AUTH_IDENTITY_TENANT_FIELD resolves it from the login response instead.

AUTH_TENANT_ID=
AUTH_USERNAME=
AUTH_PASSWORD=

# Second account used by tenant-isolation tests (P0). Requests made with the
# default credentials above must NOT be able to read or mutate this tenant.
# Leave empty and the isolation specs skip with a clear reason.
CROSS_TENANT_ID=


# === Setup verification ======================================================
# Path `npm run verify:setup` probes on the primary service after minting a
# token. Pick any cheap authenticated GET — a health route, a list endpoint, …
VERIFY_PATH=health


# === UI (optional — leave blank while you are API-only) ======================
# WEB_APP_URL       — the app URL; used as Playwright `baseURL` for UI projects.
# WEB_APP_LOGIN_URL — only if the login page lives at a different URL.
WEB_APP_URL=
WEB_APP_LOGIN_URL=

# Text that proves the browser login worked (a heading on the landing page).
WEB_APP_POST_LOGIN_HEADING=Dashboard


# === Notifications (optional) ================================================
# Channel: teams | slack | none.  With no webhook the notifier writes
# reports/notification.json instead of posting, so CI never fails on this.
NOTIFY_CHANNEL=none
NOTIFY_WEBHOOK_URL=
NOTIFY_WHEN=always
